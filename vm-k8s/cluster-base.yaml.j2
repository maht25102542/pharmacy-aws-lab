# ของจริงอยู่ที่: ใน Kubernetes cluster (apply จาก VM pharmacy-k8s-1 และ pharmacy-dev)
# ของพื้นฐานที่ไม่ได้อยู่ใน repo manifest เพราะมีรหัสผ่านและ IP ของเครื่อง
#   - namespace ของ cluster นี้ (prd บน k8s-1, dev บน pharmacy-dev)
#   - service ชื่อ galera ที่ชี้ออกไปยังเครื่องฐานข้อมูลนอก cluster
#   - secret ชื่อ db-credentials ที่ backend ใช้ต่อฐานข้อมูล
{% for ns in namespaces %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
---
apiVersion: v1
kind: Service
metadata:
  name: galera
  namespace: {{ ns }}
spec:
  ports:
    - port: 3306
      targetPort: 3306
---
apiVersion: v1
kind: Endpoints
metadata:
  name: galera
  namespace: {{ ns }}
subsets:
  - addresses:
{% for ip in galera_ips %}
      - ip: {{ ip }}
{% endfor %}
    ports:
      - port: 3306
---
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: {{ ns }}
stringData:
  DB_HOST: galera
  DB_NAME: pharmacy_{{ ns }}
  DB_USER: "{{ db_app_user }}"
  DB_PASSWORD: "{{ db_app_password }}"
{% endfor %}
